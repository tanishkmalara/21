"use strict";

const { Model } = require("sequelize");

module.exports = (sequelize, DataTypes) => {

  class Student extends Model {}

  Student.init({

    name: {
      type: DataTypes.STRING,
      allowNull: false
    },

    age: {
      type: DataTypes.INTEGER,
      allowNull: false
    },

    course: {
      type: DataTypes.STRING,
      allowNull: false
    }

  }, {

    sequelize,
    modelName: "Student"

  });

  return Student;
};
